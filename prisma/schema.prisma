// Esquema de la base de datos de PopiCert.
// Las migraciones viven en prisma/migrations y se aplican al arrancar el contenedor.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Lista de estado de revocación (W3C Bitstring Status List), publicada en /status/<id>.
/// Guarda la credencial `BitstringStatusListCredential` ya firmada, que se vuelve a
/// firmar en cada revocación.
model StatusList {
  /// Número de la lista: forma parte de la URL pública, así que no cambia nunca.
  id         Int           @id
  purpose    String        @default("revocation")
  /// Número de entradas (bits). Como mínimo 131.072, como pide la especificación.
  size       Int
  credential Json
  /// Se incrementa cada vez que se vuelve a firmar la lista.
  version    Int           @default(1)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  entries    StatusEntry[]

  @@map("status_list")
}

/// Una posición de una lista de estado, asignada a una credencial al emitirla.
model StatusEntry {
  id               String     @id @default(uuid()) @db.Uuid
  listId           Int        @map("list_id")
  /// Posición en la lista. Aleatoria: no sigue el orden de emisión.
  index            Int
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt        DateTime?  @map("revoked_at") @db.Timestamptz(3)
  revocationReason String?    @map("revocation_reason")
  list             StatusList @relation(fields: [listId], references: [id])

  @@unique([listId, index])
  @@index([listId, revokedAt])
  @@map("status_entry")
}

/// Registro de auditoría de las acciones del admin: quién (email de Cloudflare Access), qué y cuándo.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actorEmail String   @map("actor_email")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  details    Json?

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("audit_log")
}

/// Plantilla de diploma. Su contenido vive en las versiones: una versión usada
/// en certificados emitidos no cambia nunca (lo garantizan triggers en la base
/// de datos), así que el PDF de un certificado sale siempre igual.
model Template {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String            @map("created_by")
  versions  TemplateVersion[]

  @@map("template")
}

model TemplateVersion {
  id          String         @id @default(uuid()) @db.Uuid
  templateId  String         @map("template_id") @db.Uuid
  /// 1, 2, 3… dentro de la plantilla.
  version     Int
  /// SVG ya saneado.
  svg         String
  svgSha256   String         @map("svg_sha256")
  /// "landscape" o "portrait".
  orientation String
  /// Configuración de cada campo: [{ key, label, scope, required, public }].
  fields      Json
  /// Qué se quitó al sanear y avisos al subirla: { removed: string[], warnings: string[] }.
  report      Json
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String         @map("created_by")
  /// Se fija al emitir el primer certificado con esta versión. Desde entonces no cambia nada.
  lockedAt    DateTime?      @map("locked_at") @db.Timestamptz(3)
  template    Template       @relation(fields: [templateId], references: [id])
  fonts       TemplateFont[]

  @@unique([templateId, version])
  @@map("template_version")
}

/// Fuente subida con una versión de la plantilla (TTF, OTF o WOFF).
model TemplateFont {
  id        String          @id @default(uuid()) @db.Uuid
  versionId String          @map("version_id") @db.Uuid
  fileName  String          @map("file_name")
  family    String
  bold      Boolean
  italic    Boolean
  data      Bytes
  sha256    String
  version   TemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, family, bold, italic])
  @@map("template_font")
}
