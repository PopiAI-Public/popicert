{
  "name": "popicert",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma open source de certificados con Open Badges 3.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "keygen": "tsx scripts/keygen.ts",
    "sample-credential": "tsx scripts/sample-credential.ts",
    "check-contexts": "tsx scripts/check-contexts.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@digitalbazaar/credentials-context": "3.2.0",
    "@digitalbazaar/data-integrity": "2.5.0",
    "@digitalbazaar/data-integrity-context": "2.0.1",
    "@digitalbazaar/ed25519-multikey": "1.3.1",
    "@digitalbazaar/eddsa-rdfc-2022-cryptosuite": "1.3.0",
    "@digitalbazaar/multikey-context": "2.0.1",
    "@digitalbazaar/vc": "7.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "did-context": "3.1.1",
    "next": "16.4.6",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "4.0.18"
  }
}
