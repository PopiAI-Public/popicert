# Configuración de PopiCert. Copia este fichero a .env y rellénalo.
# Todas las variables se leen del entorno; en producción las pone Dokploy.

# URL pública DEFINITIVA, sin barra final. Va grabada en cada credencial y en cada QR:
# si cambia, los certificados emitidos dejan de verificarse. De ella sale el DID
# del emisor (did:web:certificados.popiai.es).
PUBLIC_URL=https://certificados.popiai.es

# Host del panel de administración, tras Cloudflare Access.
ADMIN_HOST=certificados-admin.luismi.dev

# PostgreSQL. En local, la del docker compose (puerto 55432).
DATABASE_URL=postgresql://popicert:popicert@localhost:55432/popicert

# Clave de firma activa: semilla Ed25519 en base64url (43 caracteres).
# SECRETA. Genera una con `npm run keygen` y guárdala en el secreto del
# despliegue y en el gestor de contraseñas. Nunca en el repo.
POPICERT_SIGNING_KEY=

# Claves públicas retiradas (z6Mk…), separadas por comas. No son secretas.
# Siguen en el documento DID para que lo ya firmado verifique. Ver docs/rotacion-de-claves.md.
POPICERT_RETIRED_PUBLIC_KEYS=

# Perfil del emisor que aparece en cada credencial.
ISSUER_NAME=PopiAI
ISSUER_URL=https://popiai.es
ISSUER_EMAIL=info@popiai.es

# Cloudflare Access: la app valida el JWT de Access en cada petición del admin.
# Equipo (p. ej. `popiai` o `popiai.cloudflareaccess.com`) y AUD de la aplicación.
# Sin estas dos variables nadie puede entrar en el admin.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Emails que pueden usar el admin, separados por comas.
ADMIN_EMAILS=info@popiai.es

# Solo para `npm run dev`: entra en el admin con este email sin Cloudflare Access
# (pon ADMIN_HOST=admin.localhost:3000). Se ignora fuera de `next dev`.
DEV_ADMIN_EMAIL=

# Más adelante (KAN-14): SMTP para enviar los certificados por email.
